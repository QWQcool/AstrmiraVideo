# `.env.deploy` 的**样例**（V2.107 / 2026-11-02）。
#
# 用法：在站点服务器的部署目录（如 /root/astrmira）里
#   cp deploy/.env.deploy.example .env.deploy && chmod 600 .env.deploy
# 然后把下面每个"必填"项的 `<...>` 换成真值。**这个文件本身不含任何密钥**，
# 真实的 `.env.deploy` 绝不能进仓库、不能进镜像。
#
# ⚠️ 两条纪律（都是踩出来的）：
# 1. **重启容器必须带 `--env-file`**：
#      docker compose --env-file .env.deploy -f deploy/compose.yaml up -d app
#    不带的话 compose 里的 `${PUBLIC_BASE_URL}` / `${CORS_ORIGINS}` 会插值成空串，
#    症状是"资产地址退化成 data URL、视频参考被上游直接拒"（2026-10-30 实测踩到）。
#    `scripts/deploy.mjs` 会把这两个键推导好再启动，所以**优先用它**。
# 2. **值里不要带行尾空格**。Docker 的 env_file 解析会 trim，而文件里留着会让
#    "容器里的值比文件短 2 个字符"这种诡异现象出现（2026-10-30 实测踩到）。

# ── 必填 ────────────────────────────────────────────────────────────────────
# 对外地址：域名（走 Let's Encrypt）或 IP（Caddy 自签，浏览器告警一次）
DEPLOY_HOST=<域名或 IP>
# 对外 HTTPS 端口
DEPLOY_PORT=443
# 公网最小鉴权（api 调用要带 Authorization: Bearer <它>）；生成：openssl rand -hex 24
PUBLIC_API_TOKEN=<openssl rand -hex 24>
# 站点登录（浏览器会弹框），用户名缺省 astrmira
BASIC_AUTH_USER=astrmira
BASIC_AUTH_PASSWORD=<自己设一个强密码>

# ── 反代 / 端口 ─────────────────────────────────────────────────────────────
# 应用容器在宿主机上映射的端口（Caddy 反代到这里）
HTTP_PORT=3000

# ── 云端轨（可选）──────────────────────────────────────────────────────────
# 留空 = 访客必须自带 BYOK Key；填了 = 服务端兜底
VOLCANO_API_KEY=
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── 本地轨（可选）──────────────────────────────────────────────────────────
# 0 = 不向访客开放本地轨；1 = 开放（自用部署通常是 1）
EXPOSE_HOST_LOCAL_TRACK=1
# 视频轨的 ComfyUI（站点到它的隧道出口；见 deploy/gpu-link.sh）
COMFYUI_BASE_URL=http://172.18.0.1:18188
# 模板是**数据不是代码**：挂宿主目录，换模板只重启容器、不重建镜像
COMFYUI_TEMPLATE_DIR=/app/comfyui-templates
COMFYUI_TEMPLATE=minimax-h3-t2v
# 音频轨（配乐/音效）的 ComfyUI。**刻意不复用 COMFYUI_BASE_URL** ——
# 视频那台通常没有 Stable Audio 权重（models/checkpoints 是空的）；
# 同一台机器同时跑视频与音频时，把两个键写成同一个地址即可（那是一次显式决定）。
COMFYUI_AUDIO_BASE=

# ── 配音（可选，第三方云）────────────────────────────────────────────────────
# 填了才会有云端配音能力；文本会离开这台机器（CONTRACT §30 的隐私口径）
MIMO_API_KEY=

# ── 下面两个一般**不用手写** ────────────────────────────────────────────────
# `scripts/deploy.mjs` 会按 https://${DEPLOY_HOST} 推导并通过 shell env 传给 compose；
# 但如果你**手动** `docker compose up`，就必须让它们在 .env.deploy 里，
# 否则 compose 的 ${...} 插值为空（见文件头纪律 1）。
# PUBLIC_BASE_URL=https://<DEPLOY_HOST>
# CORS_ORIGINS=https://<DEPLOY_HOST>
