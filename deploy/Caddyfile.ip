# 反代配置 · TLS_MODE=ip（只有 IP，无域名；PLAN §9-2 次选路径）
#
# 用 Caddy 的**本地 CA** 自签证书。代价是浏览器会弹证书告警、需要手工信任一次；
# 但它仍然显著强于明文：BYOK 的 Key 走请求头，明文 HTTP 等于把 Key 公开发布。
#
# 若这一步的告警让你想退回纯 HTTP，请先读 PLAN §9-2 与 §9-3：
# 公网纯 HTTP 下前端会**主动禁用 Key 输入**（HTTPS 守卫），也就是无法出片。

{
	# 全局：启用本机 CA，让下面站点的证书由它签发（首次启动时生成）
	local_certs
}

{$DEPLOY_HOST} {
	# 使用内部 CA 签发的证书（而非 Let's Encrypt —— IP 无法申请公信证书）
	tls internal

	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	request_body {
		max_size 20MB
	}

	# 同 domain 档：不写 encode —— 任何视频压缩都会破坏 206 Range
}
