# 反代配置 · TLS_MODE=ip（只有 IP，无域名；PLAN §9-2 次选路径）
#
# 用 Caddy 的**本地 CA** 自签证书。代价是浏览器会弹证书告警、需要手工信任一次；
# 但它仍然显著强于明文：BYOK 的 Key 走请求头，明文 HTTP 等于把 Key 公开发布。

{
	# 全局：启用本机 CA，让下面站点的证书由它签发（首次启动时生成）
	local_certs

	# ⚠️ 这一行是**必须的**，缺了会导致浏览器完全打不开（连登录框都看不到）。
	#
	# RFC 6066 规定 SNI 只用于承载**域名**，所以客户端用 IP 访问时**不会发 SNI**。
	# 没有 SNI，Caddy 在握手时选不出该用哪张证书，只能回
	# `tlsv1 alert internal error`（alert 80）—— 实测在 schannel 与 Node 两侧都是这个报错，
	# 而它读起来像"服务端 TLS 坏了"，完全看不出是"少了一个默认证书标识"。
	#
	# 值必须是**纯主机名**（不能带端口），由 scripts/deploy.mjs 推导后注入。
	default_sni {$DEPLOY_SNI}
}

{$DEPLOY_HOST} {
	# 使用内部 CA 签发的证书（IP 无法申请公信证书）
	tls internal

	request_body {
		max_size 20MB
	}

	# ① 存活探针豁免登录：与后端 `ALWAYS_PUBLIC_PATHS`（/api/health）的口径保持一致。
	#    容器内的 HEALTHCHECK 走 127.0.0.1:3000 不经这里，但外部探活 / 监控需要它能匿名访问。
	@health path /api/health
	handle @health {
		reverse_proxy app:3000 {
			header_up Authorization "Bearer {$PUBLIC_API_TOKEN}"
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ② 参考资产：**必须匿名可读**（V8.3 批次 7，2026-09-23 实测缺陷）。
	#    这是"给上游读的"那一类文件：云端参考图模式（I2V / FL2V / V2V）会把
	#    `<PUBLIC_BASE_URL>/media/assets/<文件>` 交给方舟，由**上游的服务器**去抓。
	#    若这里也要求站点登录，上游只会拿到 401 → 参考图模式在线上**必然失败**
	#    （本机之所以没暴露：`PUBLIC_BASE_URL` 为空时回落成 base64 data URL，不走网络）。
	#
	#    如实说明代价：这些文件变成"知道 URL 即可读"（文件名是服务端生成的随机 UUID，
	#    不含任何用户输入）。**成片与封面仍在登录之后**，本豁免只覆盖 `assets/` 一个子目录。
	#    若部署场景不能接受，请把 `PUBLIC_BASE_URL` 留空走 data URL（请求体变大约 1.33 倍）。
	@assets path /media/assets/*
	handle @assets {
		reverse_proxy app:3000 {
			header_up Authorization "Bearer {$PUBLIC_API_TOKEN}"
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# ③ 其余全部路径：先登录，再把 Basic 凭据换成后端认的 Bearer
	handle {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}

		reverse_proxy app:3000 {
			header_up Authorization "Bearer {$PUBLIC_API_TOKEN}"
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# 同 domain 档：不写 encode —— 任何视频压缩都会破坏 206 Range
}
