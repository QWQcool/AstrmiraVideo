# ═══════════════════════════════════════════════════════════════════════════
# 部署配置模板（Step 5）
#
# 用法：复制为 .env.deploy 并填写，然后 `node scripts/deploy.mjs`
#   Windows:  Copy-Item .env.deploy.example .env.deploy
#   Linux/mac: cp .env.deploy.example .env.deploy
#
# ⚠️ .env.deploy 只在服务器本地存在，**不入镜像、不入 git**（Step 5-AC3）。
# ═══════════════════════════════════════════════════════════════════════════

# ── 需要你提供的三项（施工单 §9-1；其余全部由施工方自带默认值）──────────────

# ① 服务器地址：**有域名就填域名**（Caddy 会自动申请并续期 Let's Encrypt 证书）；
#    只有 IP 就填 IP（改用自签证书，浏览器会告警一次，需手工信任）。
#    若对外端口不是 443，请写成 host:port，例如 video.example.com:8443
DEPLOY_HOST=

# ② 对外 HTTPS 端口（建议 443；被占用则换，必须与 ① 里写的端口一致）
DEPLOY_PORT=443

# ③ 火山方舟 API Key —— **可选**。
#    这是"服务端兜底 Key"（部署者自己的额度），供访客未带 BYOK Key 时使用；
#    填了 → cloud.available=true；不填 → cloud.available=false，访客必须自带 Key 才能出片。
#    优先级：访客请求头里的 Key > 本项兜底。
VOLCANO_API_KEY=

# ── 以下由施工方提供默认值，通常无需修改 ──────────────────────────────────

# 公网最小鉴权 Token（**必填**，生产环境缺失则服务拒绝启动）。
# 生成一把随机串：openssl rand -hex 24
# 免鉴权名单：回环来源全部 + 任何来源的 /api/health
PUBLIC_API_TOKEN=

# Let's Encrypt 证书到期通知邮箱（有域名时建议填写）
ACME_EMAIL=

# 上游模型 id（填火山方舟控制台里"视频生成"模型/接入点的 id）
# 例：doubao-seedance-1-0-pro-250528
VOLCANO_MODEL_NAME=doubao-seedance-video

# 上游基址（一般不用改）
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 公网基址：云端轨需要把**参考图**交给上游，而上游只能读公网地址。
# 留空时 deploy.mjs 会自动推导为 https://${DEPLOY_HOST}；推导不出则退化为 data URL
# （data URL 有 4MB 上限，大图会被如实拒绝 —— 不静默失败）。
PUBLIC_BASE_URL=

# CORS 白名单（逗号分隔）。生产填对外地址，例如 https://video.example.com
# 留空时 deploy.mjs 会自动推导。
CORS_ORIGINS=

# 本地轨开关：0（默认）不向访客开放。个人自用想开本地轨再改（需同时配 H3_WORKDIR）
EXPOSE_HOST_LOCAL_TRACK=0

# 宿主 80 端口的映射来源（容器内恒为 80）。仅"有域名"档需要它做 ACME 挑战；
# 服务器 80 已被占用时改成高位端口即可（例如 8080 —— 但那样 ACME 的 HTTP-01 会失败，
# 届时应改用 DNS-01 或在反代前另作安排）。
HTTP_PORT=80

# ── 站点登录（Basic Auth）──────────────────────────────────────────────
# 浏览器访问时会弹框要求输入；它同时充当"边缘凭据"：
# Caddy 验证通过后，会把请求头换成后端认的 `Bearer <PUBLIC_API_TOKEN>` 再转发。
# 这样前端**完全不需要知道任何令牌**，也就不存在"在前端存密钥"的问题。
BASIC_AUTH_USER=astrmira
# 站点登录密码（**必填**）。建议生成：openssl rand -base64 18
BASIC_AUTH_PASSWORD=
