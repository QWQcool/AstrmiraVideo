# ── 云端轨：火山方舟 Seedance（BYOK）──
# 常规用法：Key 由用户在浏览器 BYOK 抽屉填入，随请求头 X-Provider-Key 发送。
# 服务端凭据模型＝**B 方案**（PLAN §6-D23）：Key 只在请求头与**进程内存**中过手，
# 入队时按 taskId 暂存、任务终态即删、不落盘 / 不写日志 / 不回显。
# ⚠️ 已知代价：进程重启会清空暂存的 Key，重启时仍在途的任务会被**如实归为 UNCERTAIN_RESULT**
#    （可能已计费 → 人工核对），绝不自动重提。绝不会出现"默默用兜底 Key 重跑"。
#
# 下面这项是**可选**的服务端兜底 Key（部署者自己的额度）；填了则 cloud.available=true。
# 优先级：请求头里的用户 Key > 本项兜底（顺序颠倒会让用户误以为在烧自己的额度）。
VOLCANO_API_KEY=
VOLCANO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 上游模型 id：填火山方舟控制台里"视频生成"模型/接入点的 id，例如 doubao-seedance-1-0-pro-250528
VOLCANO_MODEL_NAME=doubao-seedance-video

# ── 公网可访问基址（Step 5 部署后填写；本地开发留空）──
# 用途：云端轨需要把用户上传的参考图**交给上游**，上游只能读公网 URL。
# 留空时退回 data URL（本地上传的图上游读不到 localhost）；配置后形如 https://video.example.com
# 拼出的地址是 <PUBLIC_BASE_URL>/media/assets/<文件名>（与成片走同一套静态服务）
PUBLIC_BASE_URL=

# ── 本地轨：MiniMax H3 工作目录（host scope）──
# 默认 %USERPROFILE%\Desktop\MiniMaxH3，此处可覆盖
H3_WORKDIR=

# ── 已有 ComfyUI 实例（可选；仅允许回环 / 内网地址，见 PLAN §7-2）──
COMFYUI_BASE_URL=http://127.0.0.1:8188

# ── 本地轨对访客的开放开关（PLAN §6-D26）──
# 0（默认）= 不向访客开放本地轨：local.available:false，reason=「本服务未向访客开放本地轨」
# 1 = 开放（部署者自用场景；需同时配置 H3_WORKDIR 或 COMFYUI_BASE_URL）
EXPOSE_HOST_LOCAL_TRACK=0

# ── 反向代理（Step 5）──
# 置 1 时信任 X-Forwarded-For 首跳，使防线 5 的 IP 冷却在反代后仍正确（否则所有请求同 IP = 全局锁）
TRUST_PROXY=0

# ── 存储目录（可覆盖；默认值口径见 CONTRACT §7）──
OUTPUT_DIR=
DATA_DIR=

# ── 反向代理 / 进程（一般无需改）──
# PORT / HOST：后端监听端口与地址（默认 3000 / 0.0.0.0；测试时常用 127.0.0.1）
PORT=
HOST=
# FRONTEND_DIST：单进程形态下前端产物目录（默认 <repo>/frontend/dist；部署镜像里已固定）
FRONTEND_DIST=

# ── 开发期开关（生产不要开）──
# ENABLE_FIXTURE_PROVIDER：OI-2 夹具 provider（无 Key / 无 GPU / 零成本，用于本地与 CI 校验）。
#   默认：非生产环境开启、生产环境关闭（显式置 1 才在生产开启）
ENABLE_FIXTURE_PROVIDER=
# FAULT_INJECT / FAULT_KIND / FAULT_DELAY_MS / FAULT_AT_PERCENT / FAULT_STEPS：
#   开发期故障注入层（delay / rate_limit / upstream_5xx / stream_cut / disk_full / slow_progress / uncertain）。
#   FAULT_INJECT=1 才挂载；生产环境挂载直接拒绝启动（见 PLAN §4「Step 2 补充」）
FAULT_INJECT=
FAULT_KIND=
FAULT_DELAY_MS=
FAULT_AT_PERCENT=
FAULT_STEPS=

# ── 外部工具路径（缺 ffmpeg/ffprobe 时用；也可直接装进 PATH）──
FFMPEG_PATH=
FFPROBE_PATH=

# ── 本地引擎档位（可选，显式声明；见 GUIDE §一 与 CONTRACT §2）──
# 仅用于状态端点如实陈述"本服务配置了什么档位"，不参与任何自动锁定或置灰
H3_TIER=

# ── Step 5 部署目标（仅本机使用，勿写入任何 md 文档）──
# ⚠️ DEPLOY_HOST / DEPLOY_PORT 这一对是给 `scripts/deploy.mjs` 用的（DEPLOY_PORT = 对外 HTTPS 端口）。
#    它与 GitHub Actions Secret 里的同名 `DEPLOY_PORT`（**SSH 端口**）不是一回事 —— 两者同名不同义，换机时别搞混。
DEPLOY_HOST=
DEPLOY_PORT=

# ── 安全加固（PLAN §7-4 / §7-5 / §7-6）──
# 公网部署必填：最小鉴权 Token。免鉴权名单见 PLAN §7-4（回环来源全部 + 任何来源的 /api/health）
PUBLIC_API_TOKEN=
# CORS 白名单（逗号分隔）；本地开发默认 http://localhost:5173
# 注意：浏览器携带 X-Provider-Key / Idempotency-Key 属自定义请求头，服务端已在 CORS allowedHeaders 放行（代码内置）
CORS_ORIGINS=http://localhost:5173

# ── LLM 扩写（⚠️ 当前版本未实现：见 PLAN §9 台账 B3，填写不会生效）──
# demo 版 /api/prompt/enhance 固定返回 501 LLM_NOT_CONFIGURED，前端 ✨ 按钮置灰。
# 以下四项仅为 V2.0【规划】预留，当前代码不会读取：
LLM_PRESET=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
