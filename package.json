{
  "name": "astrmiravideo-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"*\" dev",
    "build": "pnpm --filter @astrmira/shared build && pnpm --filter backend build && pnpm --filter frontend build",
    "lint": "oxlint --deny-warnings backend/src frontend/src packages/shared/src",
    "type": "pnpm --filter @astrmira/shared build && pnpm --filter backend exec tsc --noEmit && pnpm --filter frontend exec tsc --noEmit",
    "test": "pnpm --filter backend test && pnpm --filter frontend test",
    "test:backend": "pnpm --filter backend test",
    "test:frontend": "pnpm --filter frontend test",
    "test:e2e": "pnpm --filter backend test:e2e",
    "test:coverage": "pnpm --filter backend test:coverage",
    "smoke:paid": "node scripts/smoke-seedance-paid.mjs",
    "test:contract": "pnpm --filter backend exec vitest run src/contract.test.ts",
    "test:fixtures": "node scripts/make-fixture-clips.mjs",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "test:browser:agent": "node tests/browser/agent-unmount.mjs",
    "test:browser:runs": "node tests/browser/runs-project.mjs",
    "test:browser:media": "node tests/browser/run-media.mjs",
    "test:browser:edges": "node tests/browser/edge-lines.mjs",
    "smoke:comfy": "node scripts/comfyui-acceptance.mjs",
    "smoke:image": "node scripts/image-edit-acceptance.mjs",
    "smoke:face": "node scripts/face-similarity-acceptance.mjs",
    "smoke:comfy:e2e": "node scripts/smoke-comfyui-e2e.mjs",
    "capture:shots": "node scripts/capture-docs-shots.mjs",
    "serve:local": "node scripts/serve-local.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "bench": "node scripts/bench.mjs",
    "test:browser:audio": "node tests/browser/edit-audio.mjs",
    "smoke:audio": "node tests/browser/edit-audio-layers.mjs",
    "smoke:audio:panel": "node tests/browser/audio-panel-e2e.mjs",
    "gpu:day-one": "node scripts/gpu-day-one.mjs"
  },
  "devDependencies": {
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0"
  }
}
